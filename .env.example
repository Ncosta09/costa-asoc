# Dominio público del sitio (sin barra final). Usado para metadata, sitemap, canonicals.
NEXT_PUBLIC_SITE_URL=https://www.costa-asoc.com.ar

# Resend — envío del formulario de contacto
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email que recibe las consultas del formulario
CONTACT_EMAIL_TO=gcosta@costa-asoc.com.ar

# Email "from" verificado en Resend (dominio verificado). Formato: Nombre <casilla@dominio>
CONTACT_EMAIL_FROM=Costa & Asociados <web@costa-asoc.com.ar>

# Google Search Console: el código va hardcodeado en app/layout.tsx (es público y permanente).
# Bing Webmaster Tools → método "meta tag" → valor del content de msvalidate.01 (opcional).
BING_SITE_VERIFICATION=

# GA4 (opcional): activarla enciende el tracking + banner de cookies.
# Crear la propiedad en analytics.google.com con la cuenta del negocio y pegar el ID.
# NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Microsoft Clarity (opcional): se carga con el mismo consentimiento que GA4.
# ID del proyecto en clarity.microsoft.com (está en la URL del proyecto).
# NEXT_PUBLIC_CLARITY_ID="xxxxxxxxxx"

# GA4 Measurement Protocol (opcional): conteo server-side y sin cookies de leads y clicks
# de WhatsApp/teléfono (eventos lead_srv, whatsapp_srv, phone_srv). Se crea en GA4 →
# Administrar → Flujos de datos → (flujo web) → Secretos de la API de Measurement Protocol.
# Vacía = no se manda nada (no rompe el form ni /api/evento).
GA4_MP_API_SECRET=
